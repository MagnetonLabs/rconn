# Litestream credentials and target. Copy to /opt/rconn/litestream.env (or next to
# compose.yaml as litestream.env), fill in, then: chmod 600 litestream.env
#
# Cloudflare R2: an R2 API token with "Object Read & Write" on this bucket only.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=rconn-db-backup
LITESTREAM_PATH=rconn.db
# R2: https://<account_id>.r2.cloudflarestorage.com  (EU jurisdiction: <account_id>.eu.r2...)
# AWS S3: leave empty and set the bucket's region below. MinIO: http://minio:9000
LITESTREAM_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_REGION=auto
