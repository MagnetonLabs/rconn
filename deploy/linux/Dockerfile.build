# Linux build environment for the Rconn app, viewer and host (run from the repo root):
#   docker build -f deploy/linux/Dockerfile.build -t rconn-linux-build deploy/linux
#   docker run --rm -v "$PWD":/src -v rconn-cargo:/usr/local/cargo/registry -v rconn-rustup:/usr/local/rustup \
#     -v rconn-linux-target:/target rconn-linux-build cargo build --release -p rconn-app
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config cmake clang \
      libx11-dev libxcb1-dev libxcb-shm0-dev libxcb-damage0-dev libxcb-xtest0-dev libxcb-randr0-dev \
      libxkbcommon-dev libwayland-dev libasound2-dev libpulse-dev \
      libgtk-3-dev libayatana-appindicator3-dev libxdo-dev \
      dpkg-dev \
 && rm -rf /var/lib/apt/lists/*
ENV CARGO_TARGET_DIR=/target
WORKDIR /src
