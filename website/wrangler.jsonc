// rconn.app as Cloudflare static assets: `npm run build && npx wrangler deploy`
{
  "name": "rconn-website",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "rconn.app", "custom_domain": true },
    { "pattern": "www.rconn.app", "custom_domain": true }
  ]
}
