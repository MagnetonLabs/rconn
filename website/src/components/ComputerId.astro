---
/* The page's one moment of motion: each digit rolls into place like a dial when the page
   loads (CSS only). With reduced motion the digits are simply there. */
interface Props { id?: string }
const { id = '067425387' } = Astro.props;
const groups = id.match(/\d{1,3}/g) ?? [];
const strip = '01234567890123456789'.split('');
let n = 0;
---

<p class="cid">
  <span class="visually-hidden">Computer ID {groups.join(' ')}</span>
  {groups.map((g) => (
    <span class="grp" aria-hidden="true">
      {g.split('').map((d) => (
        <span class="dig" style={`--d:${10 + Number(d)};--i:${n++}`}>
          <span class="strip">{strip.map((s) => <span>{s}</span>)}</span>
        </span>
      ))}
    </span>
  ))}
</p>

<style>
  .cid {
    --h: 1.04em;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.28em;
    font-weight: 800;
    font-size: clamp(2.75rem, 15.5vw, 11rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--blue);
  }
  @media (prefers-color-scheme: dark) {
    .cid { color: #5e9bff; }
  }
  .grp { display: inline-flex; }
  .dig {
    display: inline-block;
    height: var(--h);
    overflow: hidden;
  }
  .strip {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--d) * var(--h) * -1));
  }
  .strip > span { height: var(--h); line-height: var(--h); }

  @media (prefers-reduced-motion: no-preference) {
    .strip {
      animation: dial 1.15s cubic-bezier(0.22, 0.9, 0.25, 1) both;
      animation-delay: calc(120ms + var(--i) * 55ms);
    }
    @keyframes dial {
      from { transform: translateY(0); }
    }
  }
</style>
